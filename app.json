{
  "expo": {
    "name": "IIMA Eventos",
    "slug": "app_evento_ima_nativo",
    "version": "4.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para escanear QR Codes.",
          "microphonePermission": "Permita o acesso ao microfone para gravação de vídeo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "useLegacyPackaging": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withSqlite16kb.js"
    ],
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.lyfiti.app_evento_ima_nativo",
      "versionCode": 2
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Permita o acesso à câmera para escanear QR Codes.",
        "NSMicrophoneUsageDescription": "Permita o acesso ao microfone para gravação de vídeo.",
        "ITSAppUsesNonExemptEncryption": false,
        "buildNumber": "2"
      },
      "bundleIdentifier": "com.lyfiti.iimaeventos"
    },
    "extra": {
      "eas": {
        "projectId": "3f66bc84-2707-4f0b-a568-bda0f3e1ec73"
      }
    }
  }
}
